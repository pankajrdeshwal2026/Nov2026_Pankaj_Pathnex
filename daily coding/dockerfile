
# ------------------------------------------------
# 1. Select Base Image
# ------------------------------------------------
FROM python:3.12-slim

# ------------------------------------------------
# 2. Set Image Maintainer Information
# ------------------------------------------------
LABEL maintainer="pankaj@example.com"
LABEL application="Pankaj Docker Demo"
LABEL version="1.0"

# ------------------------------------------------
# 3. Set Environment Variables
# ------------------------------------------------
ENV APP_HOME=/app
ENV APP_PORT=5000
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV APP_ENV=production

# ------------------------------------------------
# 4. Set Working Directory
# ------------------------------------------------
WORKDIR ${APP_HOME}

# ------------------------------------------------
# 5. Install Required Linux Packages
# ------------------------------------------------
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    gcc \
    && apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# ------------------------------------------------
# 6. Copy Requirements File
# ------------------------------------------------
COPY requirements.txt .

# ------------------------------------------------
# 7. Install Python Dependencies
# ------------------------------------------------
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# ------------------------------------------------
# 8. Copy Application Source Code
# ------------------------------------------------
COPY app.py .

# ------------------------------------------------
# 9. Create a Non-Root Linux User
# ------------------------------------------------
RUN useradd --create-home --shell /usr/sbin/nologin pankaj && \
    chown -R pankaj:pankaj ${APP_HOME}

# ------------------------------------------------
# 10. Switch to Non-Root User
# ------------------------------------------------
USER pankaj

# ------------------------------------------------
# 11. Expose Application Port
# ------------------------------------------------
EXPOSE 5000

# ------------------------------------------------
# 12. Configure Health Check
# ------------------------------------------------
HEALTHCHECK --interval=30s \
    --timeout=5s \
    --start-period=10s \
    --retries=3 \
    CMD curl -f http://localhost:5000/ || exit 1

# ------------------------------------------------
# 13. Define Container Startup Command
# ------------------------------------------------
CMD ["python", "app.py"]
